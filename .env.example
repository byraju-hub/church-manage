# 선택 기능의 키. 값이 없으면 시연용 예시 화면으로 동작합니다.
# 실제 키는 이 파일이 아니라 .env 파일(저장소에 올라가지 않음) 또는 Cloudflare Pages 환경 변수에 넣으세요.

# 심방 녹음·문서 분석, 교인 등록카드 사진 읽기 (Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 심방 녹음 받아쓰기
OPENAI_API_KEY=

# 문자 발송 (솔라피). 발신번호는 솔라피에 등록한 번호
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 시험용: 값이 있으면 모든 문자를 이 번호 한 곳으로만 보냄
SOLAPI_TEST_TO=
